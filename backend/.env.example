DEEPSEEK_API_KEY=
HF_ENDPOINT=https://hf-mirror.com
# 单次成本估算用的单价（单位：每百万 token）。下面是 deepseek-flash 的**空闲时段**官方价
# （美元，2026-09 官方定价页）；高峰时段是它的 2 倍。填 0 表示不估算成本。
DEEPSEEK_INPUT_PRICE_PER_MILLION=0.15
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=0.6
RERANK_MODEL=
# 低相关性兜底：检索最高余弦相似度低于该值时按“资料不足”处理并引导转人工。
# 0 表示关闭；当前 backend/corpus 五篇公开语料（74 分块）的标定值是 0.37，
# 换语料后请用 backend/evaluation/calibrate_threshold.py 重新标定。
RAG_MIN_SCORE=0
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=120
OCR_ENABLED=false
# FAQ 例外语保护：问题里出现这些词时不走 FAQ 短路，改走检索（避免通用答案
# 盖掉知识库里的例外条款，例如「定制商品可以无理由退货吗」）。
# 留空 = 用默认列表（默认开启）；写 none 关闭；也可以自定义逗号分隔的列表。
# 默认值见 backend/app/faq_store.py 的 DEFAULT_EXCEPTION_MARKERS。
FAQ_EXCEPTION_MARKERS=
# 模型自答拒答的识别词（逗号分隔）：命中就给答案补一句转人工，避免用户拿到
# 「无法确认」之后没有下文。留空 = 用默认列表；写 none 关闭。
# 默认值见 backend/app/refusal.py 的 DEFAULT_REFUSAL_MARKERS。
RAG_REFUSAL_MARKERS=
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
ALERT_LATENCY_MS=5000
ALERT_HELPFUL_RATE=0.7
TICKET_WEBHOOK_URL=
OBSERVABILITY_WEBHOOK_URL=
# 可选工具工作流（workflow_mode="tools"）相关开关
TOOL_TIMEOUT_SECONDS=3
TOOL_MAX_RETRIES=1
WORKFLOW_TOTAL_TIMEOUT_SECONDS=15
TRACE_DIR=data/traces
MOCK_DATA_DIR=
# 父子切分：命中子块、生成时用父块上下文（长文档答案更完整）
HIERARCHICAL_CHUNKING=false
# 高风险写操作的审批单存放目录（退款等）
APPROVAL_DIR=data/approvals
