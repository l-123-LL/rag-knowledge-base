DEEPSEEK_API_KEY=
HF_ENDPOINT=https://hf-mirror.com
DEEPSEEK_INPUT_PRICE_PER_MILLION=0
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=0
RERANK_MODEL=
# 低相关性兜底：检索最高余弦相似度低于该值时按“资料不足”处理并引导转人工。
# 0 表示关闭；示例语料上的校准值是 0.42，换真实语料后需要重新校准。
RAG_MIN_SCORE=0
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=120
OCR_ENABLED=false
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
ALERT_LATENCY_MS=5000
ALERT_HELPFUL_RATE=0.7
TICKET_WEBHOOK_URL=
OBSERVABILITY_WEBHOOK_URL=
# 可选工具工作流（workflow_mode="tools"）相关开关
TOOL_TIMEOUT_SECONDS=3
TOOL_MAX_RETRIES=1
WORKFLOW_TOTAL_TIMEOUT_SECONDS=15
TRACE_DIR=data/traces
MOCK_DATA_DIR=
# 父子切分：命中子块、生成时用父块上下文（长文档答案更完整）
HIERARCHICAL_CHUNKING=false
